PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Local Postgres via `docker compose up -d` (see docker-compose.yml).
# In production this is provided by the hosting platform (e.g. Render's
# managed Postgres) — never hardcode a real prod connection string here.
DATABASE_URL="postgresql://dims:dims@localhost:5433/dims"

# Sign JWTs — set a long random value in production
JWT_SECRET=dev-only-secret

# Optional SMTP settings. Leave unset in development to log OTP codes
# to the server console instead of sending email.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Direct Inventory Manager <no-reply@directpharmacy.com>"
