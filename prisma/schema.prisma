generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums; role and branch are constrained by zod
// schemas at the API boundary ("administrator" | "staff", "adenta" | "haatso").
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         String
  branch       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordOtps PasswordOtp[]
}

model Medicine {
  id                String   @id @default(cuid())
  name              String
  strength          String   @default("")
  form              String
  packaging         String
  category          String
  batchNo           String   @unique
  branch            String
  manufacturer      String   @default("Unspecified")
  // "essential" | "cold-chain" | "restricted" — constrained by zod at the API boundary
  stockCategory     String   @default("essential")
  quantity          Int
  unitPriceGhs      Float
  lowStockThreshold Int      @default(50)
  expiryDate        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expiryActions ExpiryAction[]

  @@index([category])
  @@index([branch])
}

model ExpiryAction {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  // "clearance" | "transfer" | "review"
  type       String
  note       String
  createdAt  DateTime @default(now())

  @@index([medicineId])
}

model PasswordOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}
