generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums; role and branch are constrained by zod
// schemas at the API boundary ("administrator" | "staff", "adenta" | "haatso").
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  username     String    @unique
  passwordHash String
  // "super_admin" | "administrator" | "pharmacist" | "store_manager" | "cashier"
  role         String
  branch       String
  // "active" | "suspended" — suspended users are blocked at login
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  passwordOtps      PasswordOtp[]
  transferRequests  TransferRequest[]
}

model Medicine {
  id                String    @id @default(cuid())
  name              String
  genericName       String    @default("")
  strength          String    @default("")
  form              String
  packaging         String
  category          String
  // Unique per branch, not globally: the same batch can exist at multiple
  // branches once stock is transferred between them.
  batchNo           String
  branch            String
  manufacturer      String    @default("Unspecified")
  supplier          String    @default("")
  // "essential" | "cold-chain" | "restricted" — constrained by zod at the API boundary
  stockCategory     String    @default("essential")
  quantity          Int
  unitOfMeasurement String    @default("Units")
  unitPriceGhs      Float
  sellingPriceGhs   Float?
  storageLocation   String    @default("")
  lowStockThreshold Int       @default(50)
  reorderLevel      Int?
  manufacturingDate DateTime?
  internalNotes     String    @default("")
  expiryDate        DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  expiryActions      ExpiryAction[]
  transferRequests   TransferRequest[]
  consumptionRecords ConsumptionRecord[]

  @@unique([batchNo, branch])
  @@index([category])
  @@index([branch])
}

/** One row per medicine per day — daily units dispensed, the basis for usage-rate predictions. */
model ConsumptionRecord {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  date       DateTime
  quantity   Int

  @@unique([medicineId, date])
  @@index([medicineId])
  @@index([date])
}

model ExpiryAction {
  id         String   @id @default(cuid())
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  // "clearance" | "transfer" | "review"
  type       String
  note       String
  createdAt  DateTime @default(now())

  @@index([medicineId])
}

model TransferRequest {
  id                String    @id @default(cuid())
  code              String    @unique
  medicineId        String
  medicine          Medicine  @relation(fields: [medicineId], references: [id])
  // Snapshot fields so the request stays readable even if the medicine
  // row is later edited or deleted.
  medicineName      String
  batchNo           String
  packaging         String
  sourceBranch      String
  destinationBranch String
  quantity          Int
  // "pending" | "approved" | "rejected" | "completed"
  status            String    @default("pending")
  // "standard" | "express" | "critical"
  priority          String    @default("standard")
  requestedDeliveryDate DateTime?
  // Requester's context at submission time — distinct from reviewNote,
  // which belongs to whoever approves/rejects.
  notes             String    @default("")
  requestedById     String
  requestedBy       User      @relation(fields: [requestedById], references: [id])
  reviewNote        String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([status])
  @@index([sourceBranch])
}

/** Single row (id "singleton") holding app-wide configuration; read/written by the settings service only. */
model SystemSettings {
  id                   String   @id @default("singleton")
  systemName           String   @default("Direct Inventory Manager")
  organizationName     String   @default("Direct Pharmacy")
  defaultBranch        String   @default("Adenta Main")
  timezone             String   @default("Africa/Accra")
  dateFormat           String   @default("DD/MM/YYYY")
  // Expiry-risk day brackets — drive expiry-risk.service's tier thresholds
  // and medicines.service's "critical-expiry" status window.
  criticalAlertDays    Int      @default(30)
  highRiskDays         Int      @default(60)
  monitoringDays       Int      @default(90)
  // Default low-stock threshold applied to newly created medicines that
  // don't specify their own.
  minimumStockTrigger  Int      @default(20)
  // Default trailing-average window for low-stock consumption predictions.
  predictionWindowDays Int      @default(7)
  // Persisted but not yet enforced at login — see settings.service.ts.
  twoFactorRequired    Boolean  @default(false)
  autoLogoutMinutes    Int      @default(30)
  updatedAt            DateTime @updatedAt
}

model Branch {
  id            String   @id @default(cuid())
  name          String   @unique
  // "primary" | "satellite"
  type          String   @default("satellite")
  address       String   @default("")
  phone         String   @default("")
  licenseNumber String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PasswordOtp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}
